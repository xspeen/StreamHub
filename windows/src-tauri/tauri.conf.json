{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamHub",
  "version": "1.0.4",
  "identifier": "com.xspeen.streamhub",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StreamHub",
        "width": 1280,
        "height": 800,
        "minWidth": 420,
        "minHeight": 320,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "shortDescription": "StreamHub live TV",
    "publisher": "xspeen",
    "copyright": "© 2026 xspeen"
  }
}
